# Caddy of the CPQ (container cpq-caddy), on 10.16.12.5:80/443 only.
# 10.16.12.5 is open to the whole internet (NSG rule 125), so this Caddy serves the
# customer entrance and nothing else: any other name gets no answer here.
# The internal entrance (cpq-intern.…) is on the planning tool's Caddy, see
# deploy/Caddyfile.intern.
# The pipeline copies this file to /opt/sleeve-cpq/caddy/Caddyfile and reloads:
#   docker exec cpq-caddy caddy reload --config /etc/caddy/Caddyfile

# --- public entrance, for customers ---------------------------------------------
cpq.sleevetechnology.com {
	encode gzip
	# the database: only the four functions behind a shared quotation
	handle_path /sb/* {
		@customer path /rest/v1/rpc/get_shared_quote /rest/v1/rpc/update_shared_quote /rest/v1/rpc/reset_shared_quote /rest/v1/rpc/log_share_activity
		handle @customer {
			reverse_proxy cpq-supabase-kong:8000
		}
		respond 403
	}
	# the app; the PDF renderer can take a while on a large quotation
	handle {
		reverse_proxy sleeve-cpq:3000 {
			transport http {
				read_timeout 120s
			}
		}
	}
}
