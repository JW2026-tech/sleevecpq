# The CPQ's own Caddy (container sleeve-cpq-caddy) — the PUBLIC entrance, for customers,
# on the CPQ's own IP address (10.16.12.5). Colleagues come in on the internal entrance
# (deploy/Caddyfile.intern, in the planning tool's Caddy), which has the full database.
# The address comes from CPQ_DOMAIN in .env. Caddy fetches the certificate itself;
# for that, port 80 and 443 of this IP must be reachable from the internet.

{$CPQ_DOMAIN} {
	encode gzip

	# The database (the CPQ's own Supabase) at /sb/… — on this entrance only what a
	# customer's link needs: the four functions behind a shared quotation.
	handle_path /sb/* {
		@customer path /rest/v1/rpc/get_shared_quote /rest/v1/rpc/update_shared_quote /rest/v1/rpc/reset_shared_quote /rest/v1/rpc/log_share_activity
		handle @customer {
			reverse_proxy cpq-supabase-kong:8000
		}
		respond 403
	}

	# the app; the PDF renderer can take a while on a large quotation
	handle {
		reverse_proxy cpq:3000 {
			transport http {
				read_timeout 120s
			}
		}
	}
}
