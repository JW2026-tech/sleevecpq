# Copy to .env on the server (cp .env.example .env) and fill in. Never commit .env.

# The server's IP address that belongs to the CPQ (the planning tool keeps 10.16.12.4)
CPQ_BIND_IP=10.16.12.5
# The CPQ's address on the internet, without https://
CPQ_DOMAIN=cpq.sleevetechnology.com

# The same address with https://, without a slash at the end
APP_URL=https://cpq.sleevetechnology.com

# Supabase (the cloud project the CPQ uses — not the Supabase on this server)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Odoo, read-only lookup of customers and contact persons
ODOO_API_KEY=
ODOO_URL=https://american-sleeve-technology.odoo.com
ODOO_DB=american-sleeve-technology
