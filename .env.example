# Copy to /opt/sleeve-cpq/.env on the server and fill in. Never commit .env.

# --- where the CPQ lives -----------------------------------------------------
# The address colleagues open the CPQ on (internal entrance), with https://, no slash at the end
APP_URL=https://cpq.sleevetechnology.com
# The address customer links get (always the public entrance)
PUBLIC_SHARE_URL=https://quote.sleevetechnology.com

# --- the CPQ's own Supabase (supabase/, its own .env holds the secrets) -----
# What the page in the browser uses: /sb on whichever entrance it was opened on, and the ANON_KEY
PUBLIC_SUPABASE_URL=/sb
PUBLIC_SUPABASE_ANON_KEY=
# What the PDF function uses, inside the server: Kong directly, and the SERVICE_ROLE_KEY
SUPABASE_URL=http://cpq-supabase-kong:8000
SUPABASE_SERVICE_ROLE_KEY=

# --- Odoo, read-only lookup of customers and contact persons -----------------
ODOO_API_KEY=
ODOO_URL=https://american-sleeve-technology.odoo.com
ODOO_DB=american-sleeve-technology
